# Genera un hash con: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# Base Turso compartida: la aplicación solo crea tablas denil_*.
# Sin URL, desarrollo local usa data/denil-memories.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Directorio persistente: SQLite y fotos locales. Nunca dentro de public/.
DATA_DIR=./data
HOST=0.0.0.0
PORT=4321
# En HTTPS de producción: true
COOKIE_SECURE=false
# En producción: origen público exacto, por ejemplo https://memories.example.com
APP_ORIGIN=
# Opcional. Si no se configura, usa archivos locales privados.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
