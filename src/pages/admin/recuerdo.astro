---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { db } from '../../lib/db';
import { groups } from '../../lib/schema';
import { getMemory, dateSchema } from '../../lib/memories';
import { today } from '../../lib/calendar';
if (Astro.locals.access.role !== 'admin')
  return Astro.redirect('/acceso?modo=admin');
const id = Astro.url.searchParams.get('id');
const memory = id ? getMemory(id, Astro.locals.access) : null;
if (id && !memory) return Astro.redirect('/404');
const availableGroups = db
  .select({ id: groups.id, name: groups.name })
  .from(groups)
  .all();
const date =
  memory?.date ||
  (dateSchema.safeParse(Astro.url.searchParams.get('fecha')).success
    ? Astro.url.searchParams.get('fecha')!
    : today());
---

<Layout title={memory ? 'Editar recuerdo' : 'Nuevo recuerdo'} section="admin">
  <a class="back-link" href={memory ? `/recuerdos/${memory.id}` : '/admin'}
    ><Icon name="arrow" size={15} /> Volver</a
  >
  <header class="page-heading">
    <div>
      <p class="eyebrow">GUARDA LO QUE IMPORTA</p><h1>
        {memory ? 'Volver a este momento.' : 'Un nuevo recuerdo.'}
      </h1><p class="lead">
        Fotos, unas palabras y un día que quieras conservar.
      </p>
    </div>
  </header>
  <form id="memory-form" data-id={memory?.id} class="max-w-4xl">
    <section class="panel">
      <h2>La historia</h2><div class="form-grid">
        <div class="field">
          <label for="title">Título</label><input
            id="title"
            name="title"
            placeholder="Ese día junto al mar…"
            required
            maxlength="120"
            value={memory?.title}
          />
        </div><div class="field">
          <label for="date">Fecha del recuerdo</label><input
            id="date"
            name="date"
            type="date"
            required
            value={date}
          />
        </div>
      </div><div class="field">
        <label for="description">¿Qué quieres recordar?</label><textarea
          id="description"
          name="description"
          rows="4"
          maxlength="5000"
          placeholder="Los pequeños detalles también cuentan…"
          >{memory?.description}</textarea
        >
      </div><div class="field mb-0">
        <label for="tags">Etiquetas</label><input
          id="tags"
          name="tags"
          value={memory?.tags.join(', ')}
          placeholder="viajes, verano, momentos"
        /><span class="hint">Separadas por comas. Hasta 15 etiquetas.</span>
      </div>
    </section>
    <section class="panel">
      <h2>Las fotos</h2><div class="upload-zone">
        <Icon name="image" size={30} /><label for="photos"
          >Elige las fotos de este momento</label
        ><p class="hint">
          JPEG, PNG, WebP, AVIF o HEIC de iPhone · 30 MB por foto · 100 MB por
          subida
        </p><input
          id="photos"
          name="photos"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif,image/heic,image/heif,.heic,.heif"
          multiple
          required={!memory}
        /><p class="hint mt-3">
          Conservaremos los originales. Solo tú podrás descargarlos.
        </p>
      </div><div class="upload-preview" id="new-previews" aria-live="polite">
      </div>
      {
        memory && (
          <div class="upload-preview">
            {memory.photos.map((photo, i) => (
              <div class="existing-photo">
                <img src={photo.thumbnailUrl} alt={`Foto guardada ${i + 1}`} />
                <button
                  type="button"
                  data-delete-photo={photo.id}
                  aria-label={`Eliminar foto ${i + 1}`}
                >
                  ×
                </button>
              </div>
            ))}
          </div>
        )
      }
    </section>
    <section class="panel">
      <h2>¿Con quién lo compartes?</h2><p class="hint mb-3">
        Si no eliges ninguna opción, este recuerdo será solo para ti.
      </p><div class="audience-options">
        <label class="check-row"
          ><input type="checkbox" name="public" checked={memory?.public} /><Icon
            name="globe"
            size={16}
          /> Público</label
        >{
          availableGroups.map((group) => (
            <label class="check-row">
              <>
                <input
                  type="checkbox"
                  name="groups"
                  value={group.id}
                  checked={memory?.groupIds?.includes(group.id)}
                />
                <Icon name="people" size={16} />
              </>{' '}
              {group.name}
            </label>
          ))
        }
      </div>{
        !availableGroups.length && (
          <p class="hint mt-3">
            Puedes crear grupos para amigos, familia o pareja en{' '}
            <a class="underline" href="/admin/accesos">
              Accesos y API
            </a>
            .
          </p>
        )
      }
    </section>
    <p class="error" id="form-error" role="alert" hidden></p><p
      id="upload-status"
      class="hint"
      role="status"
      hidden
    >
      Guardando y preparando tus fotos. Puede tardar un momento…
    </p><div class="form-actions">
      <div>
        {
          memory && (
            <button type="button" class="button danger" id="delete-memory">
              Eliminar recuerdo
            </button>
          )
        }
      </div><div class="flex gap-3">
        <a class="button" href={memory ? `/recuerdos/${memory.id}` : '/admin'}
          >Cancelar</a
        ><button class="button primary" type="submit"
          >{memory ? 'Guardar cambios' : 'Guardar recuerdo'}</button
        >
      </div>
    </div>
  </form>
  <script src="../../scripts/editor.ts"></script>
</Layout>
